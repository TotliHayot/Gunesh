# ─────────────────────────────────────────────────────────────
#  TELEGRAM BOT TOKENLARI (BotFather'dan olinadi)
# ─────────────────────────────────────────────────────────────
# Sotuv bot — mijozlar zakaz beradigan bot
BOT_CUSTOMER_TOKEN=
# Admin bot — buyurtmalarni qabul/tasdiqlash va katalog boshqaruvi
BOT_ADMIN_TOKEN=
# Super Admin bot — do'konni sozlash va analiz
BOT_SUPERADMIN_TOKEN=

# ─────────────────────────────────────────────────────────────
#  ROLLAR (Telegram ID lar, vergul bilan ajratilgan)
# ─────────────────────────────────────────────────────────────
# Super adminlar (do'kon egasi) — Super Admin botga faqat shular kira oladi
SUPERADMIN_IDS=123456789
# Adminlar/operatorlar — Admin botga kira oladiganlar (super adminlar avtomatik admin)
ADMIN_IDS=

# ─────────────────────────────────────────────────────────────
#  MA'LUMOTLAR BAZASI (Railway Postgres avtomatik DATABASE_URL beradi)
# ─────────────────────────────────────────────────────────────
DATABASE_URL=
# Yoki lokal uchun qismlarga ajratib:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maxsulot_bot
DB_USER=postgres
DB_PASS=

# ─────────────────────────────────────────────────────────────
#  MINI APP / WEBAPP
# ─────────────────────────────────────────────────────────────
# Mini App ochiladigan public URL (Railway domeni). Bo'sh bo'lsa Railway domeni avtomatik olinadi.
WEBAPP_URL=
PUBLIC_BASE_URL=


# Xavfsizlik: faqat Telegram orqali ochilgan (initData bilan tasdiqlangan) so'rovlar
STRICT_AUTH=true
INITDATA_MAX_AGE=86400
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=60

# Vaqt mintaqasi
TIMEZONE=Asia/Tashkent


# ─────────────────────────────────────────────────────────────
#  ONLAYN TO'LOV (Payme / Click / Uzum / Paylov — WLCM agregatori)
# ─────────────────────────────────────────────────────────────
# ⚠️ ODATDA BU BO'LIMNI TO'LDIRISH SHART EMAS!
# Super Admin bot → «💳 To'lov tizimi» bo'limida WLCM tokenini kiritib,
# API kalitlarini bir tugma bilan olish mumkin — ular bazaga saqlanadi.
# Bu yerdagi qiymatlar faqat KERAK BO'LSA ishlatiladi va bazadan USTUN turadi.

# API host — FAQAT host bo'lsin, '/api/v1' qo'shilmaydi (kod o'zi qo'shadi).
# Aniq manzilni Paylov/WLCM jamoasidan tasdiqlab oling.
Base_URL=https://api.wlcm.uz
PARTNER_ID=

# WLCM bergan onboarding token. Uni bot orqali ham kiritish mumkin.
# ⚠️ Cheklangan martalik — api_key/api_secret olish uchun bir marta sarflanadi.
PROD_TOKEN=

# Onboarding orqali olinadigan kalitlar. Bot orqali olsangiz — bo'sh qoldiring.
API_KEY=
API_SECRET=

# Webhook imzo kaliti — WLCM webhook URL'ini ro'yxatga olgandan keyin beradi.
# Bot orqali ham kiritiladi. BO'SH BO'LSA webhook rad etiladi
# (soxta "to'landi" xabaridan himoya).
PAYLOV_WEBHOOK_SECRET=

# Onboarding endpoint yo'li — faqat WLCM boshqa manzil bersa o'zgartiriladi.
WLCM_ONBOARDING_PATH=/api/v1/partners/onboarding/

# Mijozga ko'rsatiladigan to'lov usullari (vergul bilan).
# Ruxsat etilganlar: payme, click, uzum, paylov
PAYLOV_PROVIDERS=payme,click,uzum,paylov
# Mijoz tanlamasa ishlatiladigan default usul
PAYLOV_PROVIDER=paylov

# To'lovdan keyin mijoz qaytariladigan manzil. Bo'sh bo'lsa bot havolasi
# (https://t.me/<bot_username>) avtomatik ishlatiladi.
PAYLOV_RETURN_URL=
# Sotuv botining username'i ('@' siz). Bo'sh bo'lsa Telegram'dan avtomatik olinadi.
BOT_CUSTOMER_USERNAME=

# Naqd (yetkazishda) to'lovni ko'rsatishmi. Faqat oldindan to'lov qabul
# qilinadigan do'kon uchun false qo'ying.
PAYMENT_ALLOW_CASH=true

# DEMO rejimi: kalitlar YO'Q bo'lsa, onlayn usul tanlanishi bilan buyurtma
# "to'langan" deb belgilanadi (haqiqiy pul o'tmaydi). Ishlab chiqarishda
# MUTLAQO false bo'lishi kerak!
PAYMENT_TEST_MODE=false

# Soliq cheki (OFD) — ixtiyoriy
PAYLOV_FISCAL_ENABLED=false
PAYLOV_FISCAL_MXIK=
PAYLOV_FISCAL_PACKAGE_CODE=
PAYLOV_FISCAL_VAT_PERCENT=0
